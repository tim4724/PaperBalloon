# paperballoon.games on Hetzner Webhosting (Apache 2.4 + PHP). The repo is the
# document root; test.paperballoon.games and mta-sts.paperballoon.games serve
# the same files.

RewriteEngine On
RewriteBase /

# Canonical host, then HTTPS. Only for the real hosts, so a local preview on
# localhost stays plain HTTP. X-Forwarded-Proto covers a TLS-terminating proxy
# in front of Apache. ACME HTTP-01 challenges must stay reachable over HTTP.
# REDIRECT_STATUS is set on the 404 page's internal redirect, which must not
# turn into a redirect to /404.html.
RewriteCond %{HTTP_HOST} ^www\.paperballoon\.games$ [NC]
RewriteRule ^ https://paperballoon.games%{REQUEST_URI} [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTP_HOST} paperballoon\.games$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Never serve dotfiles or dotdirs, except /.well-known/ (app links, ACME).
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

# mta-sts.paperballoon.games serves the MTA-STS policy (RFC 8461) and nothing
# else; README explains when the policy has to change.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTP_HOST} ^mta-sts\.paperballoon\.games$ [NC]
RewriteRule !^\.well-known/(mta-sts\.txt|acme-challenge/) - [R=404,L]

# .html URLs onto the extensionless form, an index.html onto its folder, so
# every page has one address. THE_REQUEST is the client's own request line, so
# the internal rewrites below never trigger these.
RewriteCond %{THE_REQUEST} \s/([^?\s]*/)?index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
# English is the root; /de/ makes /en/ an easy guess, and it has no index.
RewriteRule ^en/?$ / [R=301,L]

# The contact form's endpoint.
RewriteRule ^api/message$ api/message.php [END]

# The games' feedback endpoint, and the feedback desk's (admin/feedback) data.
RewriteRule ^api/feedback$ api/feedback.php [END]
RewriteRule ^api/feedback-data$ api/feedback-data.php [END]

# Liveness check for monitoring.
RewriteRule ^health$ health.txt [END]

# The contract test controller, under a room-code-shaped path because the
# Android App Links filter only claims exactly 6 characters. Test host only:
# on the apex PBTEST is a room code a real player may draw.
RewriteCond %{HTTP_HOST} ^test\.paperballoon\.games$ [NC]
RewriteRule ^PBTEST$ controller-test.html [END]

# Extensionless pages: /privacy serves privacy.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [END]

DirectoryIndex index.html

# The 404 page, in German for paths under /de/.
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/de/#">
  ErrorDocument 404 /de/404.html
</If>

# Security headers on every response, errors included.
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Cross-Origin-Opener-Policy "same-origin"
# Fully strict CSP: no inline styles or scripts anywhere. No
# upgrade-insecure-requests: it breaks plain-HTTP LAN testing.
Header always set Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

# The test host serves this whole site, which would be duplicate content.
Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} == 'test.paperballoon.games'"

# Caching. HTML (and anything not listed) revalidates on every load, so a
# deploy shows at once. Artwork and fonts ship under new names, so those are
# cached for a year; CSS/JS only when asked for by version. The deploy stamps
# each page's links with ?v=<hash of the file>; the repo's pages link them
# bare, so a local preview always shows the file as it is.
Header always set Cache-Control "no-cache"
<FilesMatch "\.(webp|woff2)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /^v=/"
</FilesMatch>
<FilesMatch "\.(ico|svg|png|xml|txt)$">
  Header always set Cache-Control "public, max-age=86400"
</FilesMatch>
<FilesMatch "^(apple-app-site-association|assetlinks\.json)$">
  ForceType application/json
  Header always set Cache-Control "public, max-age=3600"
</FilesMatch>
<Files "health.txt">
  Header always set Cache-Control "no-store"
</Files>
<FilesMatch "^(message|feedback|feedback-data)\.php$">
  Header always set Cache-Control "no-store"
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml image/x-icon
</IfModule>
